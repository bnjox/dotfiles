// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "sticky_scroll": false,
  },
  "collaboration_panel": {
    "button": false,
  },
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
  },
  "notification_panel": {
    "button": false,
  },
  "agent": {
    "favorite_models": [],
    "model_parameters": [],
    "enable_feedback": false,
  },
  "calls": {
    "share_on_join": false,
    "mute_on_join": true,
  },
  "title_bar": {
    "show_menus": false,
    "show_user_picture": false,
  },
  "auto_install_extensions": {
    "html": true,
    "svelte": true,
    "biome": true,
    "emmet": true,
    "sql": true,
    "zls": true,
    "gopls": true,
  },
  "tab_size": 2,
  "search": {
    "button": false,
  },
  "gutter": {
    "min_line_number_digits": 0,
  },
  "autosave": "on_focus_change",
  "unnecessary_code_fade": 0.7,
  "ssh_connections": [
    {
      "host": "server.local",
      "username": "local_server",
      "args": [],
      "projects": [
        {
          "paths": [
            "/Users/local_server/marvelous"
          ]
        }
      ]
    },
    {
      "host": "100.121.105.19",
      "username": "local_server",
      "args": [],
      "projects": []
    }
  ],
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "ui_font_size": 15.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Ayu Mirage",
  },
  "lsp": {
    "zls": {
      "settings": {
        "zls": {
          "enable_build_on_save": true,
        },
      },
    },
  },
  "languages": {
    "JavaScript": {
      "formatter": [
        { "code_action": "source.fixAll.biome" },
        { "code_action": "source.organizeImports.biome" },
        {
          "language_server": {
            "name": "biome",
          },
        },
      ],
      "language_servers": ["tsgo", "vtsls"],
    },
    "Python": {
      "wrap_guides": [80],
      "tab_size": 4,
      "language_servers": ["ty", "ruff"],
      "formatter": "language_server",
    },
    "Svelte": {
      "prettier": {
        "allowed": true,
      },
    },
    "TypeScript": {
      "formatter": [
        { "code_action": "source.fixAll.biome" },
        { "code_action": "source.organizeImports.biome" },
        {
          "language_server": {
            "name": "biome",
          },
        },
      ],
      "language_servers": ["tsgo", "vtsls"],
    },
    "Zig": {
      "tab_size": 4,
      "format_on_save": "on",
      "language_servers": ["zls", "..."],
      "code_actions_on_format": {
        "source.fixAll": true,
        // "source.organizeImports": true // Run code actions that sorts @import declarations.
      },
    },
  },
}
